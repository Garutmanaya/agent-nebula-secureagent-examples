# -----------------------------------------------------------------------------
# Agent Nebula SecureAgent Examples - local environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and update the values for the environment where the
# examples run. Do not add derived certs/secrets/runtime paths here; those are
# calculated from AGENT_NEBULA_EXAMPLES_ROOT by the lifecycle tooling.

# External filesystem root used for generated/runtime example state.
# The lifecycle creates and reads shared certs, Agent Nebula-issued certs,
# secrets, and per-example runtime directories below this path. Keeping this
# outside the Git repository prevents generated credentials and runtime state
# from being committed with example source code.
# Default/recommended local path: /opt/agent-nebula/examples
AGENT_NEBULA_EXAMPLES_ROOT=/opt/agent-nebula/examples

# Hostname advertised by example A2A servers in AgentCard URLs and supported
# interfaces. This must be reachable by A2A clients. For HTTPS examples, the
# hostname must also be covered by the server certificate SAN. Leave this value
# empty to use the local machine hostname automatically during lifecycle
# initialization.
# Example: aimlnode
AGENT_HOSTNAME=

# Canonical public base URL of the Agent Nebula service used by examples that
# register with or discover agents through Agent Nebula. Use the hostname that
# matches the deployed TLS certificate; do not use localhost when the service
# is advertised under another hostname.
# Example: https://aimlnode:8000
NEBULA_URL=https://YOUR_HOSTNAME:8000

# Canonical public base URL of the Agent Nebula OAuth authorization server.
# Example configuration derives OAuth metadata and token endpoint URLs from
# this single origin. The hostname must match the authorization server's public
# identity because RFC 7523 private_key_jwt client assertions are audience
# validated against the authorization server/token endpoint identity.
# Example: https://aimlnode:8092
OAUTH_URL=https://YOUR_HOSTNAME:8092

# Optional public endpoint for examples-nebula/ only. Use your ngrok-assigned domain.
# NGROK_DOMAIN=hydroxide-talon-glucose.ngrok-free.dev
# NEBULA_PROXY_CA_FILE=/opt/agent-nebula/examples/nebula-certs/trust-bundle.pem
# NEBULA_PROXY_TLS_NAME=localhost
# NEBULA_PROXY_OUTPUT=/opt/agent-nebula/examples/proxy
