{
  "initial": {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "counter-surface",
      "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": [
            "title",
            "description",
            "count",
            "increment"
          ]
        },
        {
          "id": "title",
          "component": "Text",
          "text": "Interactive Counter",
          "variant": "body"
        },
        {
          "id": "description",
          "component": "Text",
          "text": "This button sends an A2UI action back to the application over native A2A."
        },
        {
          "id": "count",
          "component": "Text",
          "text": {
            "path": "/count"
          },
          "variant": "body"
        },
        {
          "id": "increment",
          "component": "Button",
          "variant": "primary",
          "child": "increment_label",
          "action": {
            "event": {
              "name": "counter.increment",
              "context": {
                "delta": 1
              }
            }
          }
        },
        {
          "id": "increment_label",
          "component": "Text",
          "text": "Increment"
        }
      ],
      "dataModel": {
        "count": 0
      }
    }
  },
  "update": {
    "version": "v1.0",
    "updateDataModel": {
      "surfaceId": "counter-surface",
      "path": "/count",
      "value": 0
    }
  }
}
